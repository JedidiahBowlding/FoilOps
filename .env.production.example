# FoilOps production environment (manual wallet tracking only)
# Copy to .env on server and fill values.

# ===== Core =====
ENVIRONMENT=production
APP_URL=https://foilops.com
PORT=3005

SOLSCAN_API_KEY=REPLACE_SOLSCAN_API_KEY
SOLSCAN_API_BASE_URL=https://pro-api.solscan.io/v2.0

# Telegram bot
BOT_TOKEN=REPLACE_TELEGRAM_BOT_TOKEN
TEST_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_64_HEX_SECRET

# Autonomous launch discovery is read-only and never submits trades.
NEW_LAUNCH_INGESTION_ENABLED=false
NEW_LAUNCH_POLL_INTERVAL_MS=15000
NEW_LAUNCH_SIGNATURE_LIMIT=100
NEW_LAUNCH_RESCORE_INTERVAL_MINUTES=5
NEW_LAUNCH_RESCORE_MAX_AGE_HOURS=24
NEW_LAUNCH_RESCORE_LIMIT=10
ROBINHOOD_CHAIN_INGESTION_ENABLED=false
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_CHAIN_START_BLOCK=
ROBINHOOD_CHAIN_MAX_BLOCKS_PER_POLL=500
ROBINHOOD_HOLDER_LOG_MAX_BLOCKS=5000
ADMIN_CHAT_ID=REPLACE_ADMIN_CHAT_ID

# Base liquidity auto-buy. Both controls must be changed deliberately before
# an explicitly configured DRAFT can be armed. Defaults fail closed.
BASE_AUTO_BUY_ENABLED=false
BASE_AUTO_BUY_KILL_SWITCH=true
BASE_AUTO_BUY_INTERVAL_MS=15000
BASE_AUTO_BUY_MAX_ETH=0.12
BASE_AUTO_BUY_MAX_USDC=500
BASE_AUTO_BUY_MAX_SLIPPAGE_BPS=300
BASE_AUTO_BUY_MAX_PRICE_IMPACT_BPS=500
BASE_AUTO_BUY_MAX_GAS_ETH=0.01
BASE_AUTO_BUY_MIN_LIQUIDITY_USD=10000
BASE_AUTO_BUY_SUPPORTED_DEXES=uniswap,aerodrome,baseswap,pancakeswap

# Database
DATABASE_URL=postgresql://handi:REPLACE_DB_PASSWORD@localhost:5433/handi_cat

# Wallet private key encryption (AES-256-GCM). Generate: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=REPLACE_64_HEX_CHARS

# Multi-active execution wallets (weighted allocation)
MULTI_ACTIVE_WALLETS_ENABLED=true
MAX_ACTIVE_PERSONAL_WALLETS=3
MULTI_ACTIVE_WALLET_CACHE_TTL_MS=15000

# Solana / Helius
HELIUS_API_KEY=REPLACE_HELIUS_API_KEY
QUICKNODE_RPC_URL=REPLACE_QUICKNODE_HTTPS_URL
QUICKNODE_WSS_URL=REPLACE_QUICKNODE_WSS_URL
RPC_ENDPOINTS=REPLACE_QUICKNODE_HTTPS_URL
# Required by Rust receiver (singular)
RPC_ENDPOINT=REPLACE_QUICKNODE_HTTPS_URL
# Required by Rust receiver websocket subscriptions
RPC_WEBSOCKET_ENDPOINT=REPLACE_QUICKNODE_WSS_URL

# FoilOps wallet
FOILOPS_WALLET_ADDRESS=REPLACE_FOILOPS_WALLET_ADDRESS

# ===== Manual-only wallet tracking =====
MANUAL_WALLET_TRACK_ONLY=true
WHALE_AUTO_TRACK_ENABLED=false
SCAM_MONITOR_ENABLED=false

# ===== Security toggles =====
ALLOW_PRIVATE_KEY_EXPORT=false
INCLUDE_PRIVATE_KEYS_IN_BACKUP=false
ENCRYPT_BACKUP=false
BACKUP_ENCRYPTION_KEY=
BACKUP_FILE=

# ===== Dashboard auth (include pw) =====
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=REPLACE_STRONG_DASHBOARD_PASSWORD
DASHBOARD_SESSION_SECRET=REPLACE_LONG_RANDOM_SESSION_SECRET

# ===== Trade signal emitter (TypeScript -> Rust) =====
TRADING_BOT_URL=http://127.0.0.1:8787
TRADE_SIGNAL_ENDPOINT=http://127.0.0.1:8787/signals
TRADE_SIGNAL_TIMEOUT_MS=4000
TRADE_SIGNAL_REQUIRE_AUTH=true
TRADE_SIGNAL_AUTH_SECRET=REPLACE_64_HEX_OR_LONG_RANDOM_SECRET
TRADE_SIGNAL_DRY_RUN=false

# Optional runtime override for platform intelligence JSON
TRACE_PLATFORM_WALLETS_JSON=

# Solscan wallet profile integration
SOLSCAN_API_KEY=
SOLSCAN_API_BASE_URL=https://pro-api.solscan.io/v2.0

# ===== Rust signal receiver controls =====
SIGNAL_RECEIVER_BIND=127.0.0.1:8787
SIGNAL_RECEIVER_DRY_RUN=false
SIGNAL_REQUIRE_AUTH=true
SIGNAL_AUTH_SECRET=REPLACE_64_HEX_OR_LONG_RANDOM_SECRET
# Optional Jupiter endpoint override/fallback order (comma-separated)
JUPITER_API_BASES=https://api.jup.ag/swap/v1,https://lite-api.jup.ag/swap/v1,https://quote-api.jup.ag/v6
SIGNAL_VERY_EARLY_MODE=true
SIGNAL_MAX_RISK_SCORE=90
SIGNAL_DEDUP_WINDOW_SECONDS=45
SIGNAL_MAX_TIMESTAMP_SKEW_SECONDS=30
# Auto-block source wallet profile after the first successful copied buy (next-launch-only behavior)
SIGNAL_AUTO_BLOCK_SOURCE_WALLET_AFTER_BUY=true
# Persist startup behavior across PM2 restarts
TRADING_ENABLED=true
TRADING_PAUSED=false

# ===== Optional RPC resiliency =====
ALLOW_PUBLIC_RPC_FALLBACK=false
RPC_ENDPOINT_COOLDOWN_MS=15000
