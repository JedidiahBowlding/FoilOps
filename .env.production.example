# FoilOps production environment (manual wallet tracking only)
# Copy to .env on server and fill values.

# ===== Core =====
ENVIRONMENT=production
APP_URL=https://foilops.com
PORT=3005

# Telegram bot
BOT_TOKEN=REPLACE_TELEGRAM_BOT_TOKEN
TEST_BOT_TOKEN=
ADMIN_CHAT_ID=REPLACE_ADMIN_CHAT_ID

# Database
DATABASE_URL=postgresql://handi:REPLACE_DB_PASSWORD@localhost:5433/handi_cat

# Solana / Helius
HELIUS_API_KEY=REPLACE_HELIUS_API_KEY
RPC_ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=REPLACE_HELIUS_API_KEY
# Required by Rust receiver (singular)
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=REPLACE_HELIUS_API_KEY

# FoilOps wallet
FOILOPS_WALLET_ADDRESS=REPLACE_FOILOPS_WALLET_ADDRESS

# ===== Manual-only wallet tracking =====
MANUAL_WALLET_TRACK_ONLY=true
WHALE_AUTO_TRACK_ENABLED=false
SCAM_MONITOR_ENABLED=false

# ===== Security toggles =====
ALLOW_PRIVATE_KEY_EXPORT=false
INCLUDE_PRIVATE_KEYS_IN_BACKUP=false
ENCRYPT_BACKUP=false
BACKUP_ENCRYPTION_KEY=
BACKUP_FILE=

# ===== Dashboard auth (include pw) =====
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=REPLACE_STRONG_DASHBOARD_PASSWORD
DASHBOARD_SESSION_SECRET=REPLACE_LONG_RANDOM_SESSION_SECRET

# ===== Trade signal emitter (TypeScript -> Rust) =====
TRADING_BOT_URL=http://127.0.0.1:8787
TRADE_SIGNAL_ENDPOINT=http://127.0.0.1:8787/signals
TRADE_SIGNAL_TIMEOUT_MS=4000
TRADE_SIGNAL_REQUIRE_AUTH=true
TRADE_SIGNAL_AUTH_SECRET=REPLACE_64_HEX_OR_LONG_RANDOM_SECRET
TRADE_SIGNAL_DRY_RUN=false

# Optional runtime override for platform intelligence JSON
TRACE_PLATFORM_WALLETS_JSON=

# Solscan wallet profile integration
SOLSCAN_API_KEY=
SOLSCAN_API_BASE_URL=https://pro-api.solscan.io/v2.0

# ===== Rust signal receiver controls =====
SIGNAL_RECEIVER_BIND=127.0.0.1:8787
SIGNAL_RECEIVER_DRY_RUN=false
SIGNAL_REQUIRE_AUTH=true
SIGNAL_AUTH_SECRET=REPLACE_64_HEX_OR_LONG_RANDOM_SECRET
SIGNAL_MAX_RISK_SCORE=90
SIGNAL_DEDUP_WINDOW_SECONDS=300
SIGNAL_MAX_TIMESTAMP_SKEW_SECONDS=120

# ===== Optional RPC resiliency =====
ALLOW_PUBLIC_RPC_FALLBACK=false
RPC_ENDPOINT_COOLDOWN_MS=15000
