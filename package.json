{
  "name": "foilops_wallet-tracker",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsc && node ./dist/src/main.js",
    "start:test": "tsc && node ./dist/src/test.js",
    "start-both": "./start-both.sh",
    "start-both:health": "bash scripts/start-both-health-check.sh",
    "postinstall": "prisma generate",
    "db:setup": "bash scripts/setup-db.sh",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev --skip-seed",
    "db:backup": "npx ts-node scripts/backup-db.ts",
    "db:backup:enc": "ENCRYPT_BACKUP=true INCLUDE_PRIVATE_KEYS_IN_BACKUP=true npx ts-node scripts/backup-db.ts",
    "db:seed": "npx ts-node scripts/seed-db.ts",
    "db:seed:enc": "BACKUP_FILE=database_backup.enc.json npx ts-node scripts/seed-db.ts",
    "signals:self-test": "node scripts/signal-receiver-self-test.js",
    "rpc:slot": "node scripts/quicknode-get-slot.js",
    "diag:launch": "node scripts/launch-delay-check.js",
    "signals:ci:test": "SIGNAL_TEST_BASE_URL=http://127.0.0.1:8787 node scripts/signal-receiver-self-test.js",
    "wallets:cleanup": "npx ts-node scripts/cleanup-wallets.ts",
    "send:alert": "npx ts-node scripts/send-user-alerts.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"  --ignore-path .gitignore",
    "format:check": "pnpm format --check",
    "format:write": "pnpm format --write"
  },
  "keywords": [],
  "author": "draco",
  "packageManager": "pnpm@9.15.2",
  "license": "ISC",
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "2.0.0",
    "@prisma/client": "^5.16.2",
    "@raydium-io/raydium-sdk": "1.3.1-beta.58",
    "@solana/spl-token": "^0.3.0",
    "@solana/spl-token-registry": "^0.2.4574",
    "@solana/web3.js": "^1.94.0",
    "axios": "^1.7.7",
    "bs58": "^6.0.0",
    "chalk": "4.1.2",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.15.0",
    "express": "^4.19.2",
    "gradient-string": "^2.0.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "p-limit": "3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/supertest": "^7.2.0",
    "prettier": "^3.3.3",
    "prisma": "^5.16.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "vitest": "^4.1.4"
  }
}
