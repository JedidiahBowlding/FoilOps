# Get this key from https://www.helius.dev For onLogs connection
HELIUS_API_KEY=

# Place in here as many RPC providers you want and separate them with a comma. e.g: https://rpc1.com,https://rpc2.com
# See https://www.quicknode.com or https://chainstack.com for free RPCs. The more connections here, the more wallets you can track
RPC_ENDPOINTS=https://api.mainnet-beta.solana.com

# Get this from Bot Father
BOT_TOKEN=
 
# Security toggles
# Set to true only in tightly controlled environments.
ALLOW_PRIVATE_KEY_EXPORT=false
INCLUDE_PRIVATE_KEYS_IN_BACKUP=false
ENCRYPT_BACKUP=false

# Required when ENCRYPT_BACKUP=true.
# Use a 32-byte base64 key or 64-char hex key.
# Example (base64): BACKUP_ENCRYPTION_KEY=Z2VuZXJhdGVkXzMyX2J5dGVzX2Jhc2U2NF9rZXlfX18=
BACKUP_ENCRYPTION_KEY=

# Optional for db:seed. Auto-detects database_backup.enc.json first if omitted.
BACKUP_FILE=

# Your chat id to access admin commands
ADMIN_CHAT_ID=

# (optional)
# This is the url where your server is deployed, only use this when using webhook Telegram connection (in production)
# Make sure you dont have a "/" at the end or it will break!!
APP_URL=https://app-url.com

# change to "production" to use webhook and use "development" for polling (if set to production, APP_URL must be defined!)
ENVIRONMENT=development

# Database connection string
DATABASE_URL=

HANDICAT_WALLET_ADDRESS=your-wallet-address

# Trade signal emitter (TypeScript intelligence plane -> Rust execution plane)
TRADE_SIGNAL_ENDPOINT=http://127.0.0.1:8787/signals
TRADE_SIGNAL_TIMEOUT_MS=4000
TRADE_SIGNAL_REQUIRE_AUTH=false
TRADE_SIGNAL_AUTH_SECRET=

# Rust signal receiver controls
SIGNAL_RECEIVER_BIND=127.0.0.1:8787
SIGNAL_RECEIVER_DRY_RUN=true
SIGNAL_REQUIRE_AUTH=true
SIGNAL_AUTH_SECRET=
SIGNAL_DEDUP_WINDOW_SECONDS=300
SIGNAL_MAX_TIMESTAMP_SKEW_SECONDS=120
