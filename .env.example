# Get this key from https://www.helius.dev For onLogs connection
HELIUS_API_KEY=

# QuickNode (recommended for low-latency copy trading)
# Rotate and paste your new key before enabling live trading.
QUICKNODE_RPC_URL=
QUICKNODE_WSS_URL=

# Place in here as many RPC providers you want and separate them with a comma. e.g: https://rpc1.com,https://rpc2.com
# See https://www.quicknode.com or https://chainstack.com for free RPCs. The more connections here, the more wallets you can track
RPC_ENDPOINTS=
# Required by Rust bot (single endpoint format)
RPC_ENDPOINT=
# Required by Rust bot websocket subscriptions
RPC_WEBSOCKET_ENDPOINT=

# Get this from Bot Father
BOT_TOKEN=
# Random secret sent by Telegram with every webhook request. Required in production.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
 
# Security toggles
# Set to true only in tightly controlled environments.
ALLOW_PRIVATE_KEY_EXPORT=false
INCLUDE_PRIVATE_KEYS_IN_BACKUP=false
ENCRYPT_BACKUP=false

# Required when ENCRYPT_BACKUP=true.
# Use a 32-byte base64 key or 64-char hex key.
# Example (base64): BACKUP_ENCRYPTION_KEY=Z2VuZXJhdGVkXzMyX2J5dGVzX2Jhc2U2NF9rZXlfX18=
BACKUP_ENCRYPTION_KEY=

# Optional for db:seed. Auto-detects database_backup.enc.json first if omitted.
BACKUP_FILE=

# Your chat id to access admin commands
ADMIN_CHAT_ID=

# (optional)
# This is the url where your server is deployed, only use this when using webhook Telegram connection (in production)
# Make sure you dont have a "/" at the end or it will break!!
APP_URL=https://app-url.com

# Rust trading API base URL used by FoilOps /trading_* Telegram commands
TRADING_BOT_URL=http://127.0.0.1:8787

# change to "production" to use webhook and use "development" for polling (if set to production, APP_URL must be defined!)
ENVIRONMENT=development

# Database connection string
DATABASE_URL=

# Base mainnet deep-research RPC (chain ID 8453). Use a private provider in production.
BASE_RPC_URL=https://mainnet.base.org
# Optional: enables Base contract creator/deployment provenance through Etherscan V2.
BASESCAN_API_KEY=
# 0x Swap API key for Base quotes and transactions.
ZEROX_API_KEY=
# Dedicated low-balance Base execution wallet. Never use a primary wallet.
BASE_EXECUTION_PRIVATE_KEY=
# Dedicated execution RPC; keep separate from research/ingestion provider quotas.
BASE_SWAP_RPC_URL=https://mainnet.base.org
BASE_SWAP_ENABLED=false
BASE_SWAP_MIN_LIQUIDITY_USD=10000
BASE_SWAP_MAX_RISK_SCORE=45
BASE_SWAP_MAX_SLIPPAGE_BPS=300
BASE_SWAP_MAX_TRADE_ETH=0.05
BASE_LAUNCH_WATCH_INTERVAL_MS=15000

# Encryption key for private keys stored in the database (AES-256-GCM).
# REQUIRED — generate with: openssl rand -hex 32
# Must be 64 hex characters (32 bytes). Keep this secret and back it up separately.
# Losing this key makes all stored private keys unrecoverable.
WALLET_ENCRYPTION_KEY=

# Multi-active execution wallets (weighted allocation)
MULTI_ACTIVE_WALLETS_ENABLED=false
MAX_ACTIVE_PERSONAL_WALLETS=3
MULTI_ACTIVE_WALLET_CACHE_TTL_MS=15000

# Preferred wallet address key
FOILOPS_WALLET_ADDRESS=your-wallet-address

# Trade signal emitter (TypeScript intelligence plane -> Rust execution plane)
TRADE_SIGNAL_ENDPOINT=http://127.0.0.1:8787/signals
TRADE_SIGNAL_TIMEOUT_MS=4000
TRADE_SIGNAL_REQUIRE_AUTH=false
TRADE_SIGNAL_AUTH_SECRET=
# Risk score attached to auto-emitted COPY_TRADE signals
COPY_TRADE_RISK_SCORE=35

# Autonomous Pump.fun launch discovery. Scoring/persistence only; does not trade.
NEW_LAUNCH_INGESTION_ENABLED=false
NEW_LAUNCH_POLL_INTERVAL_MS=15000
NEW_LAUNCH_SIGNATURE_LIMIT=100
NEW_LAUNCH_RESCORE_INTERVAL_MINUTES=5
NEW_LAUNCH_RESCORE_MAX_AGE_HOURS=24
NEW_LAUNCH_RESCORE_LIMIT=10

# Robinhood Chain EVM contract-deployment discovery. Supply the official RPC
# endpoint for the network you intend to monitor; no URL or chain ID is assumed.
ROBINHOOD_CHAIN_INGESTION_ENABLED=false
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_CHAIN_START_BLOCK=
ROBINHOOD_CHAIN_MAX_BLOCKS_PER_POLL=500
ROBINHOOD_HOLDER_LOG_MAX_BLOCKS=5000

# Base liquidity auto-buy remains unavailable until explicitly enabled.
BASE_AUTO_BUY_ENABLED=false
# Unoverrideable server-side stop. The persistent frontend master switch also defaults OFF.
BASE_AUTO_BUY_HARD_KILL_SWITCH=false
BASE_AUTO_BUY_INTERVAL_MS=15000
BASE_AUTO_BUY_MAX_ETH=0.12
BASE_AUTO_BUY_MAX_USDC=500
BASE_AUTO_BUY_MAX_SLIPPAGE_BPS=300
BASE_AUTO_BUY_MAX_PRICE_IMPACT_BPS=500
BASE_AUTO_BUY_MAX_GAS_ETH=0.01
BASE_AUTO_BUY_MIN_LIQUIDITY_USD=10000
BASE_AUTO_BUY_SUPPORTED_DEXES=uniswap,aerodrome,baseswap,pancakeswap

# Upstream TradingAgents runs as an isolated loopback-only Python service.
# Generate a long random bridge token and use the exact same value for both processes.
TRADINGAGENTS_ENABLED=false
TRADINGAGENTS_BRIDGE_URL=http://127.0.0.1:8790
TRADINGAGENTS_BRIDGE_TOKEN=
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.6
TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.6-luna
ETHEREUM_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
AVALANCHE_RPC_URL=

# Rust signal receiver controls
SIGNAL_RECEIVER_BIND=127.0.0.1:8787
SIGNAL_RECEIVER_DRY_RUN=true
SIGNAL_REQUIRE_AUTH=true
SIGNAL_AUTH_SECRET=your_secret_key_32_characters_long_!!!!
JUPITER_API_BASES=https://api.jup.ag/swap/v1,https://lite-api.jup.ag/swap/v1,https://quote-api.jup.ag/v6
SIGNAL_MAX_RISK_SCORE=90
SIGNAL_DEDUP_WINDOW_SECONDS=300
SIGNAL_MAX_TIMESTAMP_SKEW_SECONDS=120
SIGNAL_AUTO_BLOCK_SOURCE_WALLET_AFTER_BUY=false
TRADING_ENABLED=false
TRADING_PAUSED=false

# ============================================================================
# PHASE 4: Trading Control & Staged Rollout
# ============================================================================

# Trading mode: ultra_conservative (1%) | conservative (10%) | normal (100%) | aggressive (150%)
# Start with ultra_conservative and escalate after monitoring
TRADING_MODE=ultra_conservative

# Must explicitly enable live trading (default: false)
TRADING_ENABLED=false

# Initial pause state (resume when ready)
TRADING_PAUSED=false

# Max concurrent open positions
MAX_CONCURRENT_TRADES=5

# Max total open position size (SOL)
MAX_POSITION_SIZE_SOL=0.05

# Buy amount (SOL)
BUY_AMOUNT_SOL=0.01

# Min liquidity required (USD)
MIN_LIQUIDITY_USD=1000.0

# Position limits
STOP_LOSS_PERCENTAGE=20.0
TAKE_PROFIT_PERCENTAGE=1.0

# Slippage tolerance (%)
SLIPPAGE=3.0

# DEX preferences (comma-separated)
ALLOWED_DEXES=pump_fun,raydium

# MEV service (jito | nozomi | zero_slot | none)
MEV_SERVICE=jito

# Token blacklist/whitelist (comma-separated mints)
DENYLIST_TOKENS=
ALLOWLIST_TOKENS=
SIGNAL_AUTH_SECRET=your-signal-auth-secret
SIGNAL_DEDUP_WINDOW_SECONDS=300
SIGNAL_MAX_TIMESTAMP_SKEW_SECONDS=120

# Trading bot control (Rust trading bot HTTP API)
TRADING_BOT_URL=http://127.0.0.1:8787
SIGNAL_AUTH_SECRET=
SIGNAL_DEDUP_WINDOW_SECONDS=300
SIGNAL_MAX_TIMESTAMP_SKEW_SECONDS=120
