generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  FREE
  HOBBY
  PRO
  WHALE
}

enum WalletStatus {
  ACTIVE
  USER_PAUSED
  SPAM_PAUSED
  BANNED
}

enum HandiCatStatus {
  ACTIVE
  PAUSED
}

enum PromotionType {
  UPGRADE_TO_50_WALLETS
}

model User {
  id                      String             @id
  username                String
  firstName               String
  lastName                String

  hasDonated              Boolean          @default(false)

  botStatus               HandiCatStatus   @default(ACTIVE)

  personalWalletPubKey    String
  personalWalletPrivKey   String
  
  userSubscription        UserSubscription?
  userWallets             UserWallet[]
  userPromotions          UserPromotion[]
  groups                  Group[]
  alertRules              UserAlertRule[]

  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model Wallet {
  id            String         @id @default(cuid())
  address       String
  
  userWallets   UserWallet[]
  scamWallet    ScamWallet?
}

enum ScamSource {
  CURATED_DB
  MANUAL
  DETECTED
}

enum ScamEventType {
  SUSPICIOUS_TOKEN_LAUNCH
  SUSPICIOUS_PRELAUNCH_SIGNAL
  MANUAL_FLAG
  MANUAL_UNFLAG
  FLOW_TRACE
  PLATFORM_INTERACTION
  FLOW_TO_NEW_LAUNCH
  TOKEN_INVESTIGATION
  ANOMALY_DETECTED
  CLUSTER_ALERT
}

enum AlertEventType {
  SUSPICIOUS_TOKEN_LAUNCH
  SUSPICIOUS_PRELAUNCH_SIGNAL
  ANOMALY_DETECTED
  PLATFORM_INTERACTION
  FLOW_TO_NEW_LAUNCH
  TOKEN_INVESTIGATION
  CLUSTER_ALERT
}

model ScamWallet {
  id               String          @id @default(cuid())
  walletId          String          @unique
  address           String          @unique
  isFlagged         Boolean         @default(true)
  source            ScamSource      @default(CURATED_DB)
  reason            String
  priorTokenMints   String[]        @default([])
  baseRiskScore     Int             @default(50)
  lastSeenAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  events            ScamWalletEvent[]

  @@index([isFlagged])
  @@index([baseRiskScore])
}

model ScamWalletEvent {
  id                 String        @id @default(cuid())
  scamWalletId       String
  eventType          ScamEventType
  txSignature        String?
  tokenMint          String?
  platform           String?
  riskScoreSnapshot  Int
  details            String?
  metadata           Json?
  createdAt          DateTime      @default(now())

  scamWallet         ScamWallet    @relation(fields: [scamWalletId], references: [id], onDelete: Cascade)

  @@index([scamWalletId])
  @@index([eventType])
  @@index([createdAt])
  @@unique([scamWalletId, txSignature, eventType])
}

model UserWallet {
  userId          String
  walletId        String
  name            String
  address         String

  handiCatStatus  HandiCatStatus   @default(ACTIVE)
  status          WalletStatus     @default(ACTIVE)

  user            User             @relation(fields: [userId], references: [id])
  wallet          Wallet           @relation(fields: [walletId], references: [id])

  @@id([userId, walletId]) 
}

model UserSubscription {
  id                             String            @id @default(cuid())
  plan                           SubscriptionPlan  @default(FREE)

  isCanceled                     Boolean           @default(false)
  subscriptionCurrentPeriodEnd   DateTime?

  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  userId                         String            @unique
  user                           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Promotion {
  id String @id @default(cuid())
  name String
  type PromotionType
  price Decimal
  isActive Boolean @default(true)
  isStackable Boolean 

  userPromotions UserPromotion[]
}

model UserPromotion {
   id String @id @default(cuid())

   purchasedAt DateTime  @default(now())

   userId String 
   user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  promotionId String 
  promotion    Promotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Group {
  id String @id

  name String

  userId String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletCluster {
  id           String   @id @default(cuid())
  clusterScore Float
  wallets      String[]
  riskScore    Int
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([riskScore])
  @@index([createdAt])
}

model UserAlertRule {
  id                 String           @id @default(cuid())
  userId             String
  minRiskScore       Int              @default(70)
  minTransactionSize Float            @default(0)
  eventTypes         AlertEventType[] @default([SUSPICIOUS_TOKEN_LAUNCH, ANOMALY_DETECTED, SUSPICIOUS_PRELAUNCH_SIGNAL])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── FoilOps Launch Intelligence Models ───────────────────────────────────────

enum WalletClassification {
  EARLY_ENTRANT
  MOMENTUM_WALLET
  HIGH_RISK
  WATCHLIST
  IGNORE
}

enum TokenClassification {
  SAFER_SPECULATIVE
  WATCHLIST
  HIGH_RISK
  EXTREME_RISK
}

enum ClusterLinkType {
  SHARED_FUNDER
  CO_LAUNCH
  SHARED_COUNTERPARTY
  SIMILAR_EXIT_PATTERN
  DOWNSTREAM_CONSOLIDATION
}

model WalletProfileSnapshot {
  id                       String               @id @default(cuid())
  wallet                   String
  overallOpportunityScore  Int
  overallRiskScore         Int
  classification           WalletClassification
  earlyEntryScore          Int
  launchParticipationScore Int
  momentumParticipationScore Int
  repeatSuccessScore       Int
  exitTimingScore          Int
  rugRiskScore             Int
  dumpSeverityScore        Int
  clusterSuspicionScore    Int
  liquidityPullScore       Int
  suspiciousFundingScore   Int
  tags                     String[]             @default([])
  computedAt               DateTime             @default(now())

  launchRecords            LaunchParticipationRecord[]

  @@index([wallet])
  @@index([classification])
  @@index([overallOpportunityScore])
  @@index([overallRiskScore])
  @@index([computedAt])
}

model LaunchParticipationRecord {
  id                   String                 @id @default(cuid())
  snapshotId           String
  wallet               String
  tokenAddress         String
  tokenSymbol          String?
  entryTimestamp       BigInt
  entryDelaySeconds    Int
  exitTimestamp        BigInt?
  exitDelaySeconds     Int?
  gainLossPct          Float?
  platform             String
  createdAt            DateTime               @default(now())

  snapshot             WalletProfileSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([wallet])
  @@index([tokenAddress])
  @@index([entryTimestamp])
}

model TokenRiskSnapshot {
  id                       String              @id @default(cuid())
  tokenAddress             String
  overallTokenRiskScore    Int
  tokenClassification      TokenClassification
  creatorHoldPercent       Float
  top10HolderPercent       Float
  liquidityUsd             Float
  liquidityRemovalPercent  Float
  suspiciousWalletLinks    Int
  walletConcentrationScore Int
  dumpPressureScore        Int
  computedAt               DateTime            @default(now())

  suspiciousEvents         SuspiciousEvent[]

  @@index([tokenAddress])
  @@index([tokenClassification])
  @@index([overallTokenRiskScore])
  @@index([computedAt])
}

model SuspiciousEvent {
  id               String             @id @default(cuid())
  snapshotId       String
  eventType        String
  eventTimestamp   BigInt
  walletAddress    String?
  details          String
  createdAt        DateTime           @default(now())

  snapshot         TokenRiskSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([eventType])
  @@index([eventTimestamp])
}

model WalletClusterEdge {
  id            String          @id @default(cuid())
  sourceWallet  String
  targetWallet  String
  linkType      ClusterLinkType
  confidence    Float
  evidence      String[]        @default([])
  createdAt     DateTime        @default(now())

  @@unique([sourceWallet, targetWallet, linkType])
  @@index([sourceWallet])
  @@index([targetWallet])
  @@index([linkType])
  @@index([confidence])
}
